# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.env

# Test / tooling caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
layoutlens_output/

# Superpowers workspace
.superpowers/

# Local ingestion downloads that are not redistributed in-repo (LAION model).
# See docs/LICENSING.md. Redistributable corpus (ACT/GDS) IS committed under corpus/.
corpus/_downloads/
reports/*.local.json

# Tier-B real pages: freeze locally for measurement, but NEVER commit their content
# (ship URL + capture script only). See docs/LICENSING.md "Real-page policy".
corpus/real/tier_b/

# Generated (not committed) screenshots for synthetic/ingested pages — see `make screenshots`.
corpus/synthetic/**/screenshot_*.png
corpus/ingested/**/screenshot_*.png
